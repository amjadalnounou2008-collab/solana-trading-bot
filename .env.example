# === Required ===
WALLET_PRIVATE_KEY=
HELIUS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Bot mode ===
PAPER_TRADE=true
USE_MEME_COUNCIL=true
MEME_COUNCIL_MIN=4
DAILY_PROFIT_TARGET_USD=50

# === Twitter / X API (same as friend's setup) ===
# Get bearer token: https://developer.x.com → your app → Keys and tokens
TWITTER_BEARER_TOKEN=
ENABLE_TWITTER_TRACKER=true
TWITTER_AUTO_BUY=false
TWITTER_KEYWORD_SEARCH=true
# Comma-separated handles — ask your friend for his TWITTER_CALLERS list
TWITTER_CALLERS=
TWITTER_POLL_SECONDS=90
TWITTER_STATS_DAYS=30
TWITTER_STATS_INTERVAL_HOURS=24

# === Optional ===
BIRDEYE_API_KEY=
DATABASE_URL=
SCAN_PUMPFUN_ENABLED=true
